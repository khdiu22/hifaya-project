# Copy this file to .env (same folder as manage.py). Never upload .env to GitHub.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Real e-mail reminders (Gmail example) ---
# Gmail needs 2-Step Verification ON and an "App password" (not your normal password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-16-letter-app-password
DEFAULT_FROM_EMAIL=Hifaya <your.address@gmail.com>
